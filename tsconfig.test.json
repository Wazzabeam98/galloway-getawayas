{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "tests/**/*.ts",
    "lib/**/*.ts",
    "config/areas.ts",
    "app/api/cron/host-payouts/route.ts",
    "app/api/cron/balance-charges/route.ts",
    "app/api/stripe/webhook/route.ts",
    "app/api/notify/route.ts",
    "app/api/cron/scheduled-messages/route.ts",
    "app/api/listings/access-code/route.ts",
    "app/api/admin/providers/route.ts",
    "app/api/services/submitted/route.ts",
    "app/api/services/skills/route.ts",
    "app/api/admin/skills/route.ts",
    "app/api/cron/error-digest/route.ts",
    "app/auth/callback/route.ts",
    "app/api/services/apply/route.ts",
    "app/api/services/resend-verification/route.ts",
    "app/api/health/route.ts",
    "app/api/stripe/refund/route.ts",
    "app/api/bookings/cancel/route.ts",
    "app/api/listings/visibility/route.ts",
    "app/api/admin/listings/decide/route.ts",
    "app/api/services/wanted/route.ts",
    "app/api/services/enquiries/route.ts",
    "app/api/services/enquiries/respond/route.ts",
    "app/api/services/enquiries/withdraw/route.ts",
    "app/api/cron/service-enquiries/route.ts",
    "app/api/services/enquiries/refresh/route.ts"
  ]
}
