# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- Supabase ---
# Public: compiled into the browser bundle, safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: bypasses row-level security. Server-side only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Second endpoint (Connect / payout events).
STRIPE_WEBHOOK_SECRET_2=

# --- Email ---
RESEND_API_KEY=

# Where alerts about businesses and enquiries go. MORE THAN ONE ADDRESS IS
# ALLOWED, separated by commas — each gets its own copy, so one bad address
# cannot silently swallow the other person's. An enquiry nobody was told about
# looks exactly like an enquiry nobody sent.
SERVICES_ALERT_EMAIL=

# Where chargeback alerts go. One address or several, same rule.
DISPUTES_ALERT_EMAIL=

# --- SMS (Twilio) ---
# Emergency enquiries only. One way: the sender ID below is alphanumeric, which
# cannot receive replies at all, and nothing can be accepted by replying to a
# text — see lib/sms.ts.
#
# Without these, texts are skipped and say so; email is unaffected.
TWILIO_ACCOUNT_SID=
# SECRET. Server-side only, never NEXT_PUBLIC_.
TWILIO_AUTH_TOKEN=
# The alphanumeric sender ID people see. Max 11 characters, letters and digits,
# no spaces. Needs no registration in the UK. Defaults to GallowayGG.
TWILIO_SMS_FROM=GallowayGG

# --- Deployments ---
# A Vercel API token for the galloway-getawayas project.
#
# NOT READ-ONLY. This comment used to say it was, and that was wrong: on
# 28 August 2026 it created production environment variables and triggered a
# production deployment. A token that can do that can also delete variables,
# promote a build and roll one back.
#
# What is read-only is scripts/check-deploy.mjs, which issues GETs and nothing
# else. The restraint is in that script, not in the credential — so anything
# else written against this variable can reach the live site, and should say so
# out loud rather than inheriting an assumption from here.
VERCEL_TOKEN=

# --- Cron ---
# Shared secret checked by the /api/cron/* routes.
CRON_SECRET=

# --- Address lookup ---
# SECRET: getAddress.io takes the key as a query-string parameter, so every
# call has to be made from the server. Never NEXT_PUBLIC_.
GETADDRESS_API_KEY=

# --- Storage ---
NEXT_PUBLIC_S3_BUCKET=
