# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- Supabase ---
# Public: compiled into the browser bundle, safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: bypasses row-level security. Server-side only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Second endpoint (Connect / payout events).
STRIPE_WEBHOOK_SECRET_2=

# --- Email ---
RESEND_API_KEY=

# --- Deployments ---
# Read-only Vercel token, scoped to the galloway-getawayas project. Used only by
# scripts/check-deploy.mjs, which issues GETs and cannot deploy or promote.
VERCEL_TOKEN=

# --- Cron ---
# Shared secret checked by the /api/cron/* routes.
CRON_SECRET=

# --- Address lookup ---
# SECRET: getAddress.io takes the key as a query-string parameter, so every
# call has to be made from the server. Never NEXT_PUBLIC_.
GETADDRESS_API_KEY=

# --- Storage ---
NEXT_PUBLIC_S3_BUCKET=
